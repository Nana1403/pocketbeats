# PocketBeats environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Core Django settings ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Upload limits (bytes) ---
MAX_AUDIO_UPLOAD_SIZE=26214400   # 25 MB
MAX_COVER_UPLOAD_SIZE=5242880    # 5 MB

# --- PostgreSQL (production) ---
# Set these to switch from SQLite to PostgreSQL. Leave POSTGRES_DB empty for SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
